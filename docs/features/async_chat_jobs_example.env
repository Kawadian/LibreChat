# Async Chat Job Queue Configuration Example
# Add these to your .env file to enable async chat processing

# Redis Configuration (Required for job queue)
USE_REDIS=true
REDIS_URI=redis://localhost:6379

# Optional Redis Configuration
# REDIS_USERNAME=your-username
# REDIS_PASSWORD=your-password
# REDIS_CA=/path/to/ca-cert.pem

# Redis Connection Settings
# REDIS_RETRY_MAX_ATTEMPTS=10
# REDIS_RETRY_MAX_DELAY=5000
# REDIS_CONNECT_TIMEOUT=10000
# REDIS_ENABLE_OFFLINE_QUEUE=true

# Worker Concurrency (Optional - default is 3)
# Adjust the concurrency in api/server/index.js:
# startChatWorker({ concurrency: 5 }); // Process up to 5 jobs concurrently

